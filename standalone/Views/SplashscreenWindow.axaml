        </Window.Resources>

        <Window.Styles>
            <Style Selector="Path.icon">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeLineCap" Value="Round"/>
                <Setter Property="StrokeJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}"/>
            </Style>
            <Style Selector="Button.hover_backgroundSetGray:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#DAE2DF"/>
            </Style>
            <Style Selector="Button.hover_backgroundSetRed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#F16464"/>
                
            </Style>
            <Style Selector="Button.hover_cursorToHand:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Cursor" Value="hand"/>
            </Style>
            <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#DAE2DF"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#22A7F2"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Style>
        </Window.Styles>

        <Border CornerRadius="8"
                Background="White"
                ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"></RowDefinition>
                        <RowDefinition Height="32"></RowDefinition>
                        <RowDefinition Height="504"></RowDefinition>
                        <RowDefinition Height="61"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_holdToDrag">
                        <TextBlock Foreground="Black"
                                   FontSize="24" VerticalAlignment="Center"
                                   Margin="17,0,0,0" FontFamily="{StaticResource FontKoho}">
                            <Underline>v</Underline>ibas
                        </TextBlock>
                        
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">

                            <Button Width="62" Height="52" Classes="hover_backgroundSetGray hover_cursorToHand"
                                    x:Name="ButtonMinimize" Click="ButtonClick_minimize">
                                <PathIcon Data="{StaticResource IconMinimize}" Width="12" Height="12" Foreground="Black"/>
                            </Button>
                            <Button Width="62" Height="52" Classes="hover_backgroundSetGray hover_cursorToHand"
                                    x:Name="ButtonMaximize" Click="ButtonClick_maximize">
                                <PathIcon Data="{StaticResource IconMaximize}" Width="12" Height="12" Foreground="Black"/>
                            </Button>
                            <Button Width="62" Height="52" Classes="hover_backgroundSetRed hover_cursorToHand"
                                    x:Name="ButtonExit" Click="ButtonClick_exit">
                                <PathIcon Data="{StaticResource IconExit}" Width="12" Height="12" Foreground="Black"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10">

                            <Button Width="149" Height="32" CornerRadius="8"
                                    Foreground="White" Background="#22A7F2"
                                    Classes="tab active"
                                    x:Name="ButtonRecentProjects" Click="ButtonClick_recentProjects">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Path Classes="icon" Data="{StaticResource IconClock}"/>
                                    <TextBlock Text="Recent projects" FontFamily="{StaticResource FontInter}" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button Width="121" Height="32" CornerRadius="8"
                                    Foreground="Black" Background="White"
                                    Classes="tab"
                                    x:Name="ButtonCommunity" Click="ButtonClick_community">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Path Classes="icon" Data="{StaticResource IconPeople}"/>
                                    <TextBlock Text="Community" FontFamily="{StaticResource FontInter}" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
        </Border>
</Window>