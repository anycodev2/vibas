<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="standalone.Views.SplashscreenWindow"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="true"
        ShowInTaskbar="True"
        Background="Transparent"
        Width="1200"
        Height="647">

        <Window.Resources>
            <FontFamily x:Key="FontKoho">avares://standalone/Assets/Fonts#KoHo</FontFamily>
            <FontFamily x:Key="FontInter">avares://standalone/Assets/Fonts#Inter</FontFamily>
            <FontFamily x:Key="FontJetBrains">avares://standalone/Assets/Fonts#JetBrains</FontFamily>        
        </Window.Resources>

        <Border CornerRadius="16"
                Background="White"
                ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"></RowDefinition>
                        <RowDefinition Height="32"></RowDefinition>
                        <RowDefinition Height="504"></RowDefinition>
                        <RowDefinition Height="61"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent">
                        <TextBlock Foreground="Black"
                                   FontSize="24" VerticalAlignment="Center"
                                   Margin="17,0,0,0" FontFamily="{StaticResource FontKoho}">
                            <Underline>v</Underline>ibas
                        </TextBlock>
                        
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">

                            <Button Width="52" Height="52">
                                <Image Source="../Assets/Icons/minimize.png" Width="12" Height="12"/>
                            </Button>
                            <Button Width="52" Height="52">
                                <Image Source="../Assets/Icons/maximize.png" Width="12" Height="12"/>
                            </Button>
                            <Button Width="52" Height="52">
                                <Image Source="../Assets/Icons/exit.png" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Spacing="30"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10">

                            <Button Width="149" Height="32"
                                    Foreground="white" Background="#22A7F2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Image Source="../Assets/Icons/clock.png" Width="16" Height="16"/>
                                    <TextBlock Text="Recent projects" FontFamily="{StaticResource FontInter}"/>
                                </StackPanel>
                            </Button>
                            <Button Width="121" Height="32"
                                    Foreground="Black">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Image Source="../Assets/Icons/people.png" Width="16" Height="16"/>
                                    <TextBlock Text="Community" FontFamily="{StaticResource FontInter}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
        </Border>
</Window>