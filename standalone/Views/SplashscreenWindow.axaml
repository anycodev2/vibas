<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="standalone.Views.SplashscreenWindow"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="true"
        ShowInTaskbar="True"
        Background="Transparent"
        Width="1200"
        Height="647">

        <Window.Resources>
            <FontFamily x:Key="FontKoho">avares://standalone/Assets/Fonts#KoHo</FontFamily>
            <FontFamily x:Key="FontInter">avares://standalone/Assets/Fonts#Inter</FontFamily>
            <FontFamily x:Key="FontJetBrains">avares://standalone/Assets/Fonts#JetBrains</FontFamily>  
            
            <StreamGeometry x:Key="IconMinimize">M0 0.5C0 0.223858 0.223858 0 0.5 0H12.5C12.7761 0 13 0.223858 13 0.5C13 0.776142 12.7761 1 12.5 1H0.5C0.223858 1 0 0.776142 0 0.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconMaximize">M2,2 V0 H12 V10 H10 V9 H11 V1 H3 V2 Z M0,2 H10 V12 H0 Z M1,3 V11 H9 V3 Z</StreamGeometry>
            <StreamGeometry x:Key="IconExit">M0.854,0.146 L12.854,12.146 L12.146,12.854 L0.146,0.854 Z M0.146,12.146 L12.146,0.146 L12.854,0.854 L0.854,12.854 Z</StreamGeometry>
            <StreamGeometry x:Key="IconClock">M7.99999 4.00001V8H11M14 8C14 8.78793 13.8448 9.56815 13.5433 10.2961C13.2417 11.0241 12.7998 11.6855 12.2426 12.2426C11.6855 12.7998 11.024 13.2417 10.2961 13.5433C9.56814 13.8448 8.78792 14 7.99999 14C7.21206 14 6.43185 13.8448 5.7039 13.5433C4.97594 13.2417 4.31451 12.7998 3.75736 12.2426C3.20021 11.6855 2.75825 11.0241 2.45672 10.2961C2.15519 9.56815 2 8.78793 2 8C2 6.4087 2.63214 4.88258 3.75736 3.75737C4.88257 2.63215 6.4087 2.00001 7.99999 2.00001C9.59129 2.00001 11.1174 2.63215 12.2426 3.75737C13.3678 4.88258 14 6.4087 14 8Z</StreamGeometry>
            <StreamGeometry x:Key="IconPeople">M11.9994 12.4793L12 12.5C12 12.65 11.992 12.798 11.9754 12.944C10.7656 13.6381 9.39476 14.0022 8.00003 14C6.55336 14 5.19536 13.616 4.0247 12.944C4.00756 12.7897 3.99932 12.6346 4.00003 12.4793C4.00243 11.7238 4.22111 10.9846 4.62803 10.348C4.98937 9.78128 5.48778 9.31484 6.07718 8.99183C6.66658 8.66881 7.32792 8.49965 8.00003 8.5C8.67225 8.49954 9.33373 8.66865 9.92325 8.99167C10.5128 9.31469 11.0113 9.78119 11.3727 10.348C11.7798 10.9845 11.9974 11.7244 12 12.48C12.8445 12.549 13.6941 12.4402 14.494 12.1607C14.5246 11.7843 14.4479 11.4069 14.2729 11.0722C14.0979 10.7376 13.8318 10.4593 13.5052 10.2696C13.1787 10.0799 12.8051 9.98654 12.4277 10.0003C12.0503 10.014 11.6846 10.1344 11.3727 10.3473M4.00003 12.4793C3.15578 12.5508 2.30664 12.4425 1.50736 12.1613C1.47693 11.785 1.55363 11.4078 1.72858 11.0733C1.90354 10.7387 2.16961 10.4605 2.49603 10.2709C2.82245 10.0812 3.19589 9.98777 3.57318 10.0014C3.95046 10.0151 4.31617 10.1352 4.62803 10.348M10 4.5C10 5.03043 9.78932 5.53914 9.41424 5.91421C9.03917 6.28929 8.53046 6.5 8.00003 6.5C7.4696 6.5 6.96089 6.28929 6.58582 5.91421C6.21074 5.53914 6.00003 5.03043 6.00003 4.5C6.00003 3.96957 6.21074 3.46086 6.58582 3.08579C6.96089 2.71071 7.4696 2.5 8.00003 2.5C8.53046 2.5 9.03917 2.71071 9.41424 3.08579C9.78932 3.46086 10 3.96957 10 4.5ZM14 6.5C14 6.69698 13.9612 6.89204 13.8858 7.07402C13.8105 7.25601 13.7 7.42137 13.5607 7.56066C13.4214 7.69995 13.256 7.81044 13.0741 7.88582C12.8921 7.9612 12.697 8 12.5 8C12.303 8 12.108 7.9612 11.926 7.88582C11.744 7.81044 11.5787 7.69995 11.4394 7.56066C11.3001 7.42137 11.1896 7.25601 11.1142 7.07402C11.0388 6.89204 11 6.69698 11 6.5C11 6.10217 11.1581 5.72064 11.4394 5.43934C11.7207 5.15804 12.1022 5 12.5 5C12.8979 5 13.2794 5.15804 13.5607 5.43934C13.842 5.72064 14 6.10217 14 6.5ZM5.00003 6.5C5.00003 6.69698 4.96123 6.89204 4.88585 7.07402C4.81047 7.25601 4.69998 7.42137 4.56069 7.56066C4.4214 7.69995 4.25604 7.81044 4.07406 7.88582C3.89207 7.9612 3.69701 8 3.50003 8C3.30305 8 3.10799 7.9612 2.92601 7.88582C2.74402 7.81044 2.57866 7.69995 2.43937 7.56066C2.30008 7.42137 2.18959 7.25601 2.11421 7.07402C2.03883 6.89204 2.00003 6.69698 2.00003 6.5C2.00003 6.10217 2.15807 5.72064 2.43937 5.43934C2.72067 5.15804 3.10221 5 3.50003 5C3.89786 5 4.27939 5.15804 4.56069 5.43934C4.84199 5.72064 5.00003 6.10217 5.00003 6.5Z</StreamGeometry>
        </Window.Resources>

        <Window.Styles>
            <Style Selector="Path.icon">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeLineCap" Value="Round"/>
                <Setter Property="StrokeJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}"/>
            </Style>
        </Window.Styles>

        <Border CornerRadius="16"
                Background="White"
                ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"></RowDefinition>
                        <RowDefinition Height="32"></RowDefinition>
                        <RowDefinition Height="504"></RowDefinition>
                        <RowDefinition Height="61"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent">
                        <TextBlock Foreground="Black"
                                   FontSize="24" VerticalAlignment="Center"
                                   Margin="17,0,0,0" FontFamily="{StaticResource FontKoho}">
                            <Underline>v</Underline>ibas
                        </TextBlock>
                        
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">

                            <Button Width="52" Height="52">
                                <PathIcon Data="{StaticResource IconMinimize}" Width="12" Height="12" Foreground="Black"/>
                            </Button>
                            <Button Width="52" Height="52">
                                <PathIcon Data="{StaticResource IconMaximize}" Width="12" Height="12" Foreground="Black"/>
                            </Button>
                            <Button Width="52" Height="52">
                                <PathIcon Data="{StaticResource IconExit}" Width="12" Height="12" Foreground="Black"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10">

                            <Button Width="149" Height="32" CornerRadius="8"
                                    Foreground="White" Background="#22A7F2"
                                    x:Name="ButtonRecentProjects" Click="ButtonClick_recentProjects">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Path Classes="icon" Data="{StaticResource IconClock}"/>
                                    <TextBlock Text="Recent projects" FontFamily="{StaticResource FontInter}"/>
                                </StackPanel>
                            </Button>
                            <Button Width="121" Height="32" CornerRadius="8"
                                    Foreground="Black" Background="White"
                                    x:Name="ButtonCommunity" Click="ButtonClick_community">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Path Classes="icon" Data="{StaticResource IconPeople}"/>
                                    <TextBlock Text="Community" FontFamily="{StaticResource FontInter}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
        </Border>
</Window>